{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-buddy/handoff/v1/assessment_to_tutor",
  "title": "Assessment to Tutor handoff (v1)",
  "description": "Sent via the controller after a score below 8/10. Empty weak_concepts blocks reteaching (one repair, then explicit failure). Controller must check concept IDs against the current lesson and quiz attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "direction",
    "task",
    "context",
    "sources",
    "expected_output",
    "uncertainty",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "handoff_id": {
      "$ref": "#/$defs/id"
    },
    "direction": {
      "const": "assessment_to_tutor"
    },
    "task": {
      "const": "reteach_weak_concepts"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_session_id",
        "round"
      ],
      "properties": {
        "learner_session_id": {
          "$ref": "#/$defs/id"
        },
        "round": {
          "enum": [
            "first",
            "retry"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "expected_output": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "lesson_version",
        "quiz_id",
        "attempt_id",
        "score",
        "weak_concepts"
      ],
      "properties": {
        "lesson_id": {
          "type": "string",
          "minLength": 1
        },
        "lesson_version": {
          "type": "integer",
          "minimum": 1
        },
        "quiz_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "weak_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept_id",
              "missed_count"
            ],
            "properties": {
              "concept_id": {
                "$ref": "#/$defs/id"
              },
              "missed_count": {
                "type": "integer",
                "minimum": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "lesson_version",
        "url",
        "license",
        "attribution"
      ],
      "properties": {
        "lesson_id": {
          "type": "string",
          "minLength": 1
        },
        "lesson_version": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reasons"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}